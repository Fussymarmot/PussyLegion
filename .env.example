# Обязательно — свои ключи с https://my.telegram.org (раздел API development tools)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Прокси (необязательно, все поля нужны вместе)
PROXY_TYPE=socks5
PROXY_HOST=1.2.3.4
PROXY_PORT=1080
PROXY_USER=
PROXY_PASS=
# для PROXY_TYPE=mtproto используется PROXY_SECRET вместо USER/PASS
PROXY_SECRET=

# ID ассистентов, которые поднимать при старте, через запятую (по умолчанию).
# Главные и самостоятельные аккаунты стартуют всегда.
# Дальше список меняется командой .autostart в Telegram
AUTOSTART=

# Главный аккаунт (ID из .accounts), через запятую. Если не задан — главным станет
# первый аккаунт, а остальные автоматически станут ассистентами.
MASTER_IDS=
