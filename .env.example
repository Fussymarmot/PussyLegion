# Обязательно — свои ключи с https://my.telegram.org (раздел API development tools)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Прокси (необязательно, все поля нужны вместе)
PROXY_TYPE=socks5
PROXY_HOST=1.2.3.4
PROXY_PORT=1080
PROXY_USER=
PROXY_PASS=
# для PROXY_TYPE=mtproto используется PROXY_SECRET вместо USER/PASS
PROXY_SECRET=

# Только для разовой миграции со старого мультиаккаунтного формата:
# ID аккаунта, чью сессию оставить основной. Если не задан, бот возьмёт
# аккаунт с ролью master, иначе самый первый. После миграции не нужен.
MASTER_IDS=

# Канал, который показывает команда .bot (больше нигде не используется)
CHANNEL=@hurodev

# Форум-группа архива (создаётся автоматически при первом запуске)
ARCHIVE_TITLE=PussyLegion · архив
ARCHIVE_ABOUT=Автоматический архив: логи и переписка по темам.
